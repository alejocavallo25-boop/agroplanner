# ── Credenciales ────────────────────────────────────────────────────────────
# El .env de producción vive SOLO en el servidor y se edita desde el
# administrador de archivos del hPanel. Nunca va al repo.
.env
.env.local
.env.production

# ── Volcados y respaldos de base ────────────────────────────────────────────
# Las migraciones versionadas (migrations/*.sql) y el esquema con datos de
# ejemplo (database.sql) SÍ van al repo. Lo que no va es un dump con datos
# reales de productores.
*dump*.sql
*backup*.sql
*respaldo*.sql
*.sql.gz
*.sql.zip

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
php-errors.log
error_log

# ── Dependencias ────────────────────────────────────────────────────────────
/vendor/
node_modules/

# ── Sistema operativo y editores ────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# ── Copias de seguridad antes de un rediseño ────────────────────────────────
# Se guardan los archivos como estaban antes de una migración grande, para poder
# comparar mientras se trabaja. Son una red local: el historial de Git ya guarda
# esa versión, así que subirlas duplicaría el proyecto entero en el repo.
_backup_*/
*.bak.css
*.bak.php

# ── Local de herramientas ───────────────────────────────────────────────────
.claude/settings.local.json
.design/
.impeccable/
